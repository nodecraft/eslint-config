{
	"name": "@nodecraft/eslint-config",
	"version": "50.1.0",
	"description": "Nodecraft base JS ESLint config",
	"keywords": [
		"eslint",
		"eslintconfig",
		"config",
		"javascript",
		"nodecraft"
	],
	"homepage": "https://github.com/nodecraft/eslint-config",
	"bugs": {
		"url": "https://github.com/nodecraft/eslint-config/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nodecraft/eslint-config.git"
	},
	"license": "MIT",
	"author": "Nodecraft Inc.",
	"type": "module",
	"main": "index.js",
	"exports": {
		".": "./index.js",
		"./base": "./configs/base.js",
		"./json": "./configs/json.js",
		"./node": "./configs/node.js",
		"./typescript": "./configs/typescript.js",
		"./vue3": "./configs/vue3.js",
		"./vue-a11y": "./configs/vue-a11y.js",
		"./configs/*": "./configs/*",
		"./plugins/async-callback": "./plugins/async-callback.js",
		"./plugins/spawnpoint-codes": "./plugins/spawnpoint-codes.js",
		"./plugins/vue": "./plugins/vue.js",
		"./plugins/*": "./plugins/*"
	},
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.1",
		"globals": "^17.7.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.7.0",
		"eslint-plugin-import-newlines": "^2.0.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-n": "^18.2.2",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-unicorn": "^72.0.0",
		"eslint-plugin-vue": "^10.10.0",
		"eslint-plugin-vuejs-accessibility": "^2.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^4.1.10",
		"vue-eslint-parser": "^10.4.1"
	},
	"peerDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.4.0",
		"eslint-plugin-import-newlines": "^2.0.0",
		"eslint-plugin-import-x": "^4.16.0",
		"eslint-plugin-n": "^18.0.1",
		"eslint-plugin-regexp": "^3.1.1",
		"eslint-plugin-unicorn": "^72.0.0",
		"eslint-plugin-vue": "^10.9.1",
		"eslint-plugin-vuejs-accessibility": "^2.5.0",
		"spawnpoint": "^2.0.0",
		"typescript": "^5.9.3 || ^6.0.0",
		"typescript-eslint": "^8.58.0",
		"vue-eslint-parser": "^10.4.0"
	},
	"peerDependenciesMeta": {
		"spawnpoint": {
			"optional": true
		},
		"eslint-plugin-vue": {
			"optional": true
		},
		"eslint-plugin-vuejs-accessibility": {
			"optional": true
		},
		"typescript": {
			"optional": true
		},
		"typescript-eslint": {
			"optional": true
		},
		"vue-eslint-parser": {
			"optional": true
		}
	},
	"files": [
		"index.js",
		"configs",
		"plugins",
		"rules"
	],
	"engines": {
		"node": ">= 24"
	}
}
